{
  "manifest_version": 3,
  "name": "TrustLens – AI Website Trust & Phishing Sentinel",
  "version": "1.0.0",
  "description": "Real-time AI analysis of website trust, rogue certificates, and phishing signals.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrustLens Security Verdict"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
